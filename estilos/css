/* ==========================================
   ESTILOS GENERALES Y MAQUETACIÓN ESTRUCTURAL
   ========================================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #f4f7f6;
  color: #333;
  line-height: 1.6;
}

/* Header */
.main-header {
  background-color: #0d233a;
  color: #ffffff;
  padding: 1.5rem;
  text-align: center;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
}

.logo-img {
  max-height: 50px;
}

/* Nav */
.main-nav {
  background-color: #1a365d;
  padding: 0.8rem;
}

.main-nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
}

.nav-btn {
  color: #ffffff;
  text-decoration: none;
  padding: 8px 16px;
  border-radius: 4px;
  transition: background 0.3s ease;
  font-weight: 500;
}

.nav-btn:hover, .nav-btn.active {
  background-color: #2b6cb0;
}

/* Layout Principal: Main + Aside */
.layout-container {
  display: flex;
  max-width: 1200px;
  margin: 20px auto;
  gap: 20px;
  padding: 0 15px;
}

.main-content {
  flex: 3;
  background: #ffffff;
  padding: 25px;
  border-radius: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.sidebar {
  flex: 1;
  background: #e2e8f0;
  padding: 20px;
  border-radius: 8px;
  height: fit-content;
}

/* Componentes Comunes */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin: 20px 0;
}

.card {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}

.card-media img {
  width: 100%;
  height: 160px;
  object-fit: cover;
}

.card-body {
  padding: 15px;
}

/* Tablas */
.table-container {
  overflow-x: auto;
  margin: 20px 0;
}

.custom-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}

.custom-table th, .custom-table td {
  border: 1px solid #cbd5e0;
  padding: 8px 12px;
  text-align: left;
}

.custom-table th {
  background-color: #2b6cb0;
  color: white;
}

.custom-table tr:nth-child(even) {
  background-color: #f7fafc;
}

/* Botones de Navegación del Pie de Página */
.page-navigation {
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
  padding-top: 15px;
  border-top: 1px solid #e2e8f0;
}

.nav-arrow-btn {
  background-color: #2b6cb0;
  color: white;
  padding: 10px 18px;
  text-decoration: none;
  border-radius: 5px;
  font-weight: bold;
}

.nav-arrow-btn.disabled {
  background-color: #cbd5e0;
  cursor: not-allowed;
}

/* Formularios y Cajas Interactivas */
.form-group {
  margin-bottom: 15px;
}

.form-group label {
  display: block;
  margin-bottom: 5px;
  font-weight: 600;
}

.form-group input, .form-group select, .form-group textarea {
  width: 100%;
  padding: 10px;
  border: 1px solid #cbd5e0;
  border-radius: 4px;
}

.interactive-box {
  background: #edf2f7;
  padding: 15px;
  border-radius: 6px;
  margin-bottom: 20px;
}

/* Footer */
.main-footer {
  background-color: #0d233a;
  color: white;
  text-align: center;
  padding: 20px;
  margin-top: 40px;
}

.footer-links {
  list-style: none;
  display: flex;
  justify-content: center;
  gap: 20px;
  margin: 10px 0;
}

.footer-links a {
  color: #63b3ed;
  text-decoration: none;
}

@media (max-width: 768px) {
  .layout-container {
    flex-direction: column;
  }
}
