/* Reset básico */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background-color: #f4f4f4;
  color: #222222;
  line-height: 1.6;
  display: grid;
  grid-template-areas:
    "header header"
    "nav nav"
    "section aside"
    "footer footer";
  grid-template-columns: 3fr 1fr;
  gap: 10px;
  padding: 10px;
  max-width: 1200px;
  margin: 0 auto;
}

/* Encabezado con Morado y Amarillo */
header {
  grid-area: header;
  background-color: #8338ec; /* Morado Original */
  color: #ffffff;
  text-align: center;
  padding: 20px;
  border-bottom: 5px solid #ffbe0b; /* Amarillo Original */
  border-radius: 5px;
}

header img {
  max-width: 120px;
  height: auto;
  margin-bottom: 10px;
}

/* Navegación Oscura con Botones Azules */
nav {
  grid-area: nav;
  background-color: #10002b; /* Azul/Morado Oscuro Original */
  padding: 10px;
  border-radius: 5px;
}

nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
}

.nav-btn {
  background-color: #3a86ff; /* Azul Original */
  color: #ffffff;
  text-decoration: none;
  padding: 10px 15px;
  border-radius: 5px;
  font-weight: bold;
  display: inline-block;
  transition: background-color 0.2s, color 0.2s;
}

.nav-btn:hover {
  background-color: #ffbe0b; /* Amarillo al pasar el mouse */
  color: #000000;
}

/* Sección Principal con Borde Morado */
section {
  grid-area: section;
  background-color: #ffffff;
  padding: 20px;
  border: 2px solid #8338ec; /* Borde Morado Original */
  border-radius: 5px;
}

section h2 {
  color: #8338ec; /* Texto Morado Original */
  margin-bottom: 15px;
}

/* Artículos dentro de Section */
article {
  background: #ffffff;
  padding: 15px;
  margin-bottom: 15px;
  border: 1px solid #ddd;
  border-radius: 5px;
}

article h3 {
  color: #8338ec;
  margin-bottom: 8px;
}

/* Formulario */
.form-container {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 15px;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-weight: bold;
  margin-bottom: 5px;
}

.form-group input,
.form-group textarea {
  padding: 10px;
  border: 1px solid #999999;
  border-radius: 5px;
  font-family: inherit;
}

/* Botones con Estilo Original */
.button-container {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 20px;
}

.action-btn {
  background-color: #3a86ff; /* Azul Original */
  color: #ffffff;
  border: none;
  padding: 10px 18px;
  border-radius: 5px;
  cursor: pointer;
  font-weight: bold;
  transition: background-color 0.2s;
}

.action-btn:hover {
  background-color: #8338ec; /* Morado al pasar el mouse */
}

/* Contenedores de Imágenes */
.imagen-container {
  text-align: center;
  margin: 25px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
}

.imagen-container img,
article img {
  width: 300px;
  max-width: 100%;
  border: 3px solid #8338ec; /* Borde Morado Original */
  border-radius: 10px;
}

/* Botón Regresar al Inicio */
.regresar {
  display: block;
  width: 220px;
  text-align: center;
  margin: 20px auto;
  padding: 10px;
  text-decoration: none;
  background-color: #8338ec; /* Morado Original */
  color: #ffffff;
  border-radius: 5px;
  font-weight: bold;
}

.regresar:hover {
  background-color: #3a86ff;
}

/* Barra Lateral (Aside) con fondo Amarillo claro y Borde Amarillo */
aside {
  grid-area: aside;
  background-color: #ffe5a5; /* Fondo Amarillo Claro Original */
  padding: 15px;
  border: 2px solid #ffbe0b; /* Borde Amarillo Original */
  border-radius: 5px;
  height: fit-content;
}

aside h3 {
  color: #10002b;
  margin-bottom: 10px;
}

/* Pie de Página (Footer) */
footer {
  grid-area: footer;
  background-color: #10002b; /* Fondo Oscuro Original */
  color: #ffffff;
  text-align: center;
  padding: 15px;
  border-radius: 5px;
}

footer h4 {
  margin-bottom: 8px;
}

footer ul {
  list-style: none;
  padding: 0;
  display: flex;
  justify-content: center;
  gap: 15px;
}

footer a {
  color: #ffbe0b; /* Enlaces en Amarillo Original */
  text-decoration: none;
}

footer a:hover {
  text-decoration: underline;
}

/* Estilo para Tablas */
table {
  width: 100%;
  border-collapse: collapse;
  margin: 15px 0;
}

th, td {
  border: 1px solid #8338ec;
  padding: 10px;
  text-align: center;
}

th {
  background-color: #8338ec;
  color: #ffffff;
}

/* Responsivo para celulares */
@media (max-width: 768px) {
  body {
    grid-template-areas:
      "header"
      "nav"
      "section"
      "aside"
      "footer";
    grid-template-columns: 1fr;
  }
}
